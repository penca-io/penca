# Docker Compose port bindings for the dev profile.
#
# Fixed ports for predictable local development. Only one dev
# instance can run at a time with these ports.
#
# After `docker compose up`, the Justfile generates docker/.penca.env
# with the resolved PENCA_* application config.
# Loopback-qualified, not bare ports. This profile is now `penca-up`'s default
# (CHA-517), which turned unpredictable ephemeral ports into well-known ones —
# and Postgres here is penca/penca with trust-ish local defaults, so binding it
# on every interface would expose it to the whole network. Compose accepts
# `IP:HOST:CONTAINER` in the same slot, so this needs no compose change. Drop
# the `127.0.0.1:` prefix deliberately if you want a LAN-reachable stack.
PG_HOST_PORT=127.0.0.1:5432
SEAWEEDFS_HOST_PORT=127.0.0.1:8333
QUERY_HOST_PORT=127.0.0.1:50052
WRITE_HOST_PORT=127.0.0.1:50053
LIFECYCLE_HOST_PORT=127.0.0.1:50054
PENCA_SQL_HOST_PORT=127.0.0.1:50060

# Scheduler cadences are not pinned here — the compose defaults (persist 1s,
# snapshot 5s) are already the interactive values; re-stating them would be two
# hand-maintained copies of one default.
