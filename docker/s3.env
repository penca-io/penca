# Penca profile: real S3 bucket as the cold tier, Postgres still local.
#
#   just penca-up --profile s3 --db ~/.penca/data
#
# Everything Penca durably owns lives in the bucket; Postgres is the hot tier
# and, under `--db`, a host directory. The `seaweedfs` compose profile is off
# for this profile (the Justfile drops it), so no unused S3 gateway is started.
#
# REQUIRED: export the bucket before bringing the stack up. There is no default
# on purpose — a silent fall-through to the dev bucket name would point a real
# deployment at the wrong place and read as an empty table rather than an
# error. Compose fails the run with the message below if it is unset.
#
#   export PENCA_S3_BUCKET=my-penca-bucket
#
# The bucket must already exist; nothing in the stack creates it (the
# bucket-init job belongs to the `seaweedfs` profile, which is off here).
OBJECT_STORAGE_BUCKET=${PENCA_S3_BUCKET:?export PENCA_S3_BUCKET to the name of an existing S3 bucket}
OBJECT_STORAGE_REGION=${PENCA_S3_REGION:-us-east-1}
OBJECT_STORAGE_SCHEME=https

# Deliberately empty, and load-bearing in both cases — see the x-object-storage
# anchor in compose.yml for why the defaults use the no-colon form that lets
# these blank out.
#
# Endpoint: empty makes ObjectStorageConfig skip `with_endpoint`, so the real
# AWS endpoint is derived from the region. Set it to a URL for an S3-compatible
# store that is not AWS (MinIO, R2, Ceph) — and drop SCHEME back to http if
# that endpoint is plaintext.
OBJECT_STORAGE_ENDPOINT=

# Credentials: default to whatever is in the ambient AWS env vars, and stay
# empty when those are unset. Empty is not a broken config — it makes
# object_store fall through to the standard AWS credential chain, which is the
# correct setting under an EC2/EKS instance role. Supply keys explicitly (or
# export AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY) when running somewhere
# without an attached role.
#
# Note this reads the *shell* env, not ~/.aws/credentials: a plain `aws
# configure` profile on disk is not visible to a container. For a local run
# against a named profile:
#
#   export AWS_ACCESS_KEY_ID=$(aws configure get aws_access_key_id)
#   export AWS_SECRET_ACCESS_KEY=$(aws configure get aws_secret_access_key)
OBJECT_STORAGE_ACCESS_KEY=${AWS_ACCESS_KEY_ID-}
OBJECT_STORAGE_SECRET_KEY=${AWS_SECRET_ACCESS_KEY-}

# Host port bindings, matching dev.env: fixed and loopback-qualified. The
# Postgres behind them is still the compose penca/penca instance, so it must
# not be bound on every interface.
PG_HOST_PORT=127.0.0.1:5432
SEAWEEDFS_HOST_PORT=127.0.0.1:8333
QUERY_HOST_PORT=127.0.0.1:50052
WRITE_HOST_PORT=127.0.0.1:50053
LIFECYCLE_HOST_PORT=127.0.0.1:50054
PENCA_SQL_HOST_PORT=127.0.0.1:50060
