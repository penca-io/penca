# Docker Compose port bindings for the test profile.
#
# Port 0 = let the OS pick a random free port, safe for parallel
# worktrees that each run their own Docker stack.
#
# After `docker compose up`, the Justfile queries the actual ports via
# `docker compose port <service> <container_port>` and generates
# docker/.penca.env with the resolved PENCA_* application config.
# Loopback-qualified like dev.env: ephemeral ports are unpredictable but still
# bound on every interface without this, and the same penca/penca Postgres sits
# behind them. `0` still means "let the kernel pick".
PG_HOST_PORT=127.0.0.1:0
SEAWEEDFS_HOST_PORT=127.0.0.1:0
QUERY_HOST_PORT=127.0.0.1:0
WRITE_HOST_PORT=127.0.0.1:0
LIFECYCLE_HOST_PORT=127.0.0.1:0
PENCA_SQL_HOST_PORT=127.0.0.1:0

# CHA-215: shrink the lifecycle ``max_segment_bytes`` cap from the
# compose.yml default (64 MiB) to 1 MiB so chunking acceptance tests
# breach the cap with ~2 MiB of data instead of ~128 MiB. The compose
# value is ``${LIFECYCLE_DEFAULT_MAX_SEGMENT_BYTES:-67108864}``, so
# this override flows into the containers via
# ``docker compose --env-file docker/test.env`` and into pytest via
# ``set -a && source docker/test.env`` in ``integration-test``.
LIFECYCLE_DEFAULT_MAX_SEGMENT_BYTES=1048576

# CHA-233: shrink the query+lifecycle ``query_timeout`` cap from the
# compose.yml default (900s = 15 min) to 2s so the acceptance tests
# for the grace window and query-runtime cap exercise the cutoff
# behavior without making the suite slow. Both penca-query and
# penca-lifecycle read ``QUERY_TIMEOUT_SECONDS``; they MUST agree on
# the value per ADR 0019. Flows into the containers via
# ``docker compose --env-file docker/test.env`` and into pytest via
# ``set -a && source docker/test.env`` in ``integration-test``.
QUERY_TIMEOUT_SECONDS=2

# CHA-441: snapshot-list cache. TTL == the QUERY_TIMEOUT_SECONDS grace (the
# correctness ceiling); the cache-hit tests do back-to-back reads well within
# it. Small entry cap is plenty for the suite's handful of tables.
QUERY_SNAPSHOT_LIST_CACHE_TTL_SECONDS=2
QUERY_SNAPSHOT_LIST_CACHE_MAX_ENTRIES=1000

# CHA-472: the write path now carries the same snapshot-list cache, so its TTL
# is bound by the SAME GC-grace ceiling (<= min(snapshot interval,
# QUERY_TIMEOUT_SECONDS)). Pin it to the 2s grace here too — leaving it on the
# compose default (30s) would let a write resolve a target from a list naming
# an already-retired+GC'd snapshot file in any test that interleaves
# write -> retire+GC -> write.
WRITE_SNAPSHOT_LIST_CACHE_TTL_SECONDS=2
WRITE_SNAPSHOT_LIST_CACHE_MAX_ENTRIES=1000

# CHA-444 (ADR 0027): hot-purge grace window — the expired-begin ledger-GC
# grace is now max(SCHEDULER_TICK_INTERVAL_SECONDS, this), replacing the old
# query_timeout coupling. The scheduler is disabled here (tick = -1 ⇒ no sweep
# floor), so this value alone bounds it; set to 2s to match the prior
# query_timeout-based grace so test timing is unchanged.
HOT_PURGE_GRACE_SECONDS=2

# Disable the lifecycle scheduler's autonomous tick loop in the
# integration test profile. The binary supports a negative value as
# "boot, log a warning, and idle forever" — see `Scheduler::run` and
# `SchedulerConfig.tick_interval_seconds`. Integration tests assert
# RPC behavior directly (Persist/Snapshot/Purge,
# ListModifiedTables, ListPersistedTables); they don't need the
# scheduler's tick loop, and the loop racing manual lifecycle calls
# breaks tests that wait past the universal grace window.
SCHEDULER_TICK_INTERVAL_SECONDS=-1

# CHA-355: per-connection Flight SQL logical-plan cache size (0 disables).
SQL_SERVER_FLIGHT_STATEMENT_CACHE_CAPACITY=128

# CHA-367: enable FmtSpan::CLOSE span timing so the query container emits one
# `... close time.busy=...` line per `get_schema`/`get_table` gRPC handler
# invocation. Only `penca-query` reads this var (docker/compose.yml), so the
# extra log volume is scoped to that container; the metadata-resolution-count
# acceptance test (TestFlightSqlPlanningResolutionCount) scrapes those CLOSE
# events to count planning gRPCs per query. No existing test scrapes the query
# container, so this does not collide with the CHA-355 sql-server log matchers.
PENCA_SPAN_TIMING=1
